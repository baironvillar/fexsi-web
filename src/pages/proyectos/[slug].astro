---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { optimizarFoto } from "../../lib/images";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project: CollectionEntry<"projects">) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

type Props = {
	project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { Content } = await render(project);

// La portada ocupa todo el ancho: se prioriza y se sirve en varios anchos.
const portada = await optimizarFoto(project.data.coverImage, {
	anchos: [800, 1280, 1600],
	sizes: "100vw",
	priority: true,
});

const galeria = await Promise.all(
	(project.data.gallery ?? []).map(async (item, index) => ({
		index,
		alt: item.alt,
		foto: await optimizarFoto(item.image, {
			anchos: [360, 720, 1200],
			sizes: "(min-width: 1024px) 280px, (min-width: 768px) 33vw, 50vw",
		}),
	})),
);
---

<Layout
	title={`${project.data.title} | Fexsi SpA`}
	description={project.data.description}
>
	<Header />

	<main class="bg-steel-50 pt-16 md:pt-20">
		<!-- Portada del proyecto -->
		<div class="relative h-[52vh] min-h-80 overflow-hidden bg-steel-950">
			<img
				src={portada.src}
				srcset={portada.srcset}
				sizes={portada.sizes}
				alt={project.data.coverAlt}
				transition:name={`proyecto-${project.id}`}
				loading={portada.loading}
				decoding={portada.decoding}
				fetchpriority={portada.fetchpriority}
				width={portada.width}
				height={portada.height}
				class="h-full w-full object-cover"
			/>
			<div
				transition:name={`proyecto-${project.id}-capa`}
				class="absolute inset-0 bg-[linear-gradient(to_top,rgba(11,17,22,0.95)_0%,rgba(11,17,22,0.55)_55%,rgba(11,17,22,0.4)_100%)]"
			>
			</div>

			<div class="shell absolute inset-x-0 bottom-0 pb-10">
				<a
					href="/#proyectos"
					class="link-underline inline-flex items-center gap-2 text-sm font-semibold text-steel-300 transition-colors hover:text-white"
				>
					<svg
						class="h-4 w-4"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M19 12H5m6 7-7-7 7-7"></path>
					</svg>
					Volver a proyectos
				</a>

				<h1
					class="mt-4 max-w-3xl font-display text-3xl font-extrabold leading-[1.08] tracking-[-0.03em] text-white sm:text-4xl lg:text-5xl"
				>
					{project.data.title}
				</h1>
			</div>
		</div>

		<!-- Contenido -->
		<div class="shell section-pad-sm">
			<div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
				<article class="lg:col-span-7">
					<p class="border-l border-steel-300 pl-5 text-xl leading-relaxed font-medium text-steel-700">
						{project.data.description}
					</p>

					<div class="article-body mt-10">
						<Content />
					</div>
				</article>

				<aside class="lg:col-span-5">
					<div class="lg:sticky lg:top-28">
						<div class="border-t border-steel-300 pt-6">
							<h2 class="tech-label text-steel-500">Ficha del proyecto</h2>
							<dl class="mt-5 grid gap-5">
								<div>
									<dt class="text-sm font-semibold text-steel-900">Área</dt>
									<dd class="mt-1 text-sm text-steel-600">
										{project.data.category}
									</dd>
								</div>
								<div>
									<dt class="text-sm font-semibold text-steel-900">Cliente</dt>
									<dd class="mt-1 text-sm text-steel-600">Sector minero e industrial</dd>
								</div>
								<div>
									<dt class="text-sm font-semibold text-steel-900">Ubicación</dt>
									<dd class="mt-1 text-sm text-steel-600">Antofagasta, Chile</dd>
								</div>
							</dl>
						</div>

						<a
							href="/#contacto"
							class="mt-8 inline-flex h-12 w-full items-center justify-center rounded-sm bg-flame-700 px-6 text-base font-semibold text-white transition-colors duration-200 hover:bg-flame-800"
						>
							Solicitar cotización
						</a>
					</div>
				</aside>
			</div>

			<!-- Galería -->
			{
				galeria.length > 0 && (
					<section class="mt-20 border-t border-steel-200 pt-12 md:mt-24">
						<h2 class="font-display text-2xl font-bold tracking-[-0.02em] text-steel-900 md:text-3xl">
							Galería del proyecto
						</h2>
						<p class="mt-2 text-sm text-steel-600">
							{galeria.length} {galeria.length === 1 ? "fotografía" : "fotografías"} del
							proyecto
						</p>
						<div class="mt-8 gap-x-4 [column-count:2] md:[column-count:3] lg:[column-count:4]">
							{galeria.map(({ foto, alt, index }) => (
								<button
									type="button"
									data-index={index}
									data-full={foto.src}
									class="group relative mb-4 block w-full break-inside-avoid cursor-pointer overflow-hidden rounded-sm bg-steel-200 shadow-hairline focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-600"
									aria-label={`Ampliar foto ${index + 1} de ${project.data.title}`}
								>
									<img
										src={foto.src}
										srcset={foto.srcset}
										sizes={foto.sizes}
										alt={alt}
										loading={foto.loading}
										decoding={foto.decoding}
										width={foto.width}
										height={foto.height}
										class="pointer-events-none h-auto w-full transition-transform duration-500 ease-expo group-hover:scale-105"
									/>
									<span class="absolute inset-0 flex items-center justify-center bg-steel-950/50 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
										<svg
											class="h-9 w-9 text-white"
											fill="none"
											viewBox="0 0 24 24"
											stroke="currentColor"
											stroke-width="1.5"
											aria-hidden="true"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
											/>
										</svg>
									</span>
								</button>
							))}
						</div>
					</section>
				)
			}

			<!-- Video de proceso -->
			{
				project.data.video && (
					<section class="mt-20 border-t border-steel-200 pt-12 md:mt-24">
						<h2 class="font-display text-2xl font-bold tracking-[-0.02em] text-steel-900 md:text-3xl">
							Proceso en taller
						</h2>
						<figure class="mt-8">
							<video
								class="mx-auto max-h-[70vh] w-auto max-w-full rounded-sm bg-steel-950 object-contain shadow-hairline"
								controls
								preload="metadata"
								playsinline
							>
								<source src={project.data.video} type="video/mp4" />
								<track
									kind="captions"
									src={project.data.videoCaptions}
									srclang="es"
									label="Español"
									default
								/>
								<track
									kind="descriptions"
									src={project.data.videoDescriptions}
									srclang="es"
									label="Descripción en español"
								/>
								<p class="p-6 text-sm text-steel-200">
									Tu navegador no puede reproducir este video.{" "}
									<a class="link-underline" href={project.data.video} download>
										Descárgalo aquí
									</a>
									.
								</p>
							</video>
							<figcaption class="mx-auto mt-4 max-w-sm text-sm text-steel-600">
								Cesta filtrante de acero inoxidable con chapa perforada, probada dentro de
								su carcasa.
							</figcaption>
						</figure>
					</section>
				)
			}
		</div>
	</main>

	<!-- Lightbox -->
	<div
		id="lightbox"
		class="fixed inset-0 z-[100] hidden flex-col items-center justify-center bg-steel-950/95 opacity-0 backdrop-blur-sm transition-opacity duration-300"
		role="dialog"
		aria-modal="true"
		aria-label={`Galería de ${project.data.title}`}
	>
		<div
			class="absolute inset-x-0 top-0 z-10 flex items-center justify-between bg-[linear-gradient(to_bottom,rgba(0,0,0,0.55),transparent)] p-4 sm:p-6"
		>
			<span
				id="lightbox-counter"
				class="tech-label rounded-sm bg-steel-950/70 px-3 py-1.5 text-steel-200 backdrop-blur-md"
			>
				1 / 1
			</span>
			<button
				type="button"
				id="lightbox-close"
				class="flex h-11 w-11 items-center justify-center rounded-sm bg-steel-950/70 text-steel-300 backdrop-blur-md transition-colors hover:bg-steel-950 hover:text-white"
				aria-label="Cerrar galería"
			>
				<svg
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M6 18 18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		<button
			type="button"
			id="lightbox-prev"
			class="absolute left-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-sm bg-steel-950/70 text-steel-300 backdrop-blur-md transition-colors hover:text-white sm:left-6"
			aria-label="Foto anterior"
		>
			<svg
				class="h-7 w-7"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
				></path>
			</svg>
		</button>

		<div
			class="relative mt-16 flex h-[80vh] w-full items-center justify-center p-4 sm:p-12"
			id="lightbox-track"
		>
			<div
				id="lightbox-spinner"
				class="absolute inset-0 hidden items-center justify-center"
			>
				<div
					class="h-12 w-12 animate-spin rounded-full border-4 border-steel-700 border-t-flame-500"
				>
				</div>
			</div>
		</div>

		<button
			type="button"
			id="lightbox-next"
			class="absolute right-2 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-sm bg-steel-950/70 text-steel-300 backdrop-blur-md transition-colors hover:text-white sm:right-6"
			aria-label="Foto siguiente"
		>
			<svg
				class="h-7 w-7"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
				></path>
			</svg>
		</button>
	</div>

	<script>
		function setupLightbox() {
			const galleryItems = document.querySelectorAll<HTMLElement>(".group[data-index]");
			const lightbox = document.getElementById("lightbox");
			const track = document.getElementById("lightbox-track");
			const closeBtn = document.getElementById("lightbox-close");
			const prevBtn = document.getElementById("lightbox-prev");
			const nextBtn = document.getElementById("lightbox-next");
			const counter = document.getElementById("lightbox-counter");
			const spinner = document.getElementById("lightbox-spinner");

			if (!galleryItems.length || !lightbox || !track) return;

			// El script corre también en astro:page-load: se enlaza una sola vez
			// para no duplicar listeners ni imágenes dentro del lightbox.
			if (lightbox.dataset.bound === "true") return;
			lightbox.dataset.bound = "true";

			const images: string[] = [];
			const alts: string[] = [];
			galleryItems.forEach((item) => {
				// La miniatura tiene srcset: el lightbox usa la variante grande
				// declarada en data-full y cae al src de la miniatura si no existe.
				const full = item.dataset.full;
				const img = item.querySelector("img");
				const url = full ?? img?.src;
				if (url) images.push(url);
				alts.push(img?.alt ?? "Imagen ampliada del proyecto");
			});

			if (!images.length) return;

			// La imagen se crea en JS: el HTML queda sin etiquetas img sin src.
			const lightboxImg = new Image();
			lightboxImg.alt = alts[0];
			lightboxImg.className =
				"max-h-full max-w-full select-none rounded-sm object-contain opacity-0 shadow-panel transition-opacity duration-300";
			track.appendChild(lightboxImg);

			lightboxImg.addEventListener("load", () => {
				spinner?.classList.add("hidden");
				spinner?.classList.remove("flex");
				lightboxImg.classList.remove("opacity-0");
			});

			let currentIndex = 0;

			const show = (index: number) => {
				currentIndex = index;
				spinner?.classList.remove("hidden");
				spinner?.classList.add("flex");
				lightboxImg.classList.add("opacity-0");
				lightboxImg.alt = alts[currentIndex] ?? "Imagen ampliada del proyecto";
				lightboxImg.src = images[currentIndex];
				if (counter) {
					counter.textContent = `${currentIndex + 1} / ${images.length}`;
				}
			};

			const open = (index: number) => {
				show(index);
				lightbox.classList.remove("hidden");
				void lightbox.offsetWidth;
				lightbox.classList.remove("opacity-0");
				document.body.style.overflow = "hidden";
				closeBtn?.focus();
			};

			const close = () => {
				lightbox.classList.add("opacity-0");
				setTimeout(() => {
					lightbox.classList.add("hidden");
					document.body.style.overflow = "";
				}, 300);
			};

			const goNext = () => open((currentIndex + 1) % images.length);
			const goPrev = () => open((currentIndex - 1 + images.length) % images.length);

			galleryItems.forEach((btn, idx) => {
				btn.addEventListener("click", () => open(idx));
			});

			closeBtn?.addEventListener("click", close);
			nextBtn?.addEventListener("click", goNext);
			prevBtn?.addEventListener("click", goPrev);

			lightbox.addEventListener("click", (e) => {
				if (e.target === lightbox || e.target === track) close();
			});

			document.addEventListener("keydown", (e) => {
				if (lightbox.classList.contains("hidden")) return;
				if (e.key === "Escape") close();
				if (e.key === "ArrowRight") goNext();
				if (e.key === "ArrowLeft") goPrev();
			});
		}

		setupLightbox();
		document.addEventListener("astro:page-load", setupLightbox);
	</script>

	<Footer />
</Layout>
