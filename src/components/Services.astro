---
const servicios = [
	{
		title: "Maestranza",
		description:
			"Servicios de mecanizado de alta precisión para fabricación y recuperación de piezas industriales con tornos, fresadoras y mandrinadoras.",
		alcance: ["Mecanizado de alta precisión", "Tornos", "Fresadoras", "Mandrinadoras"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
	},
	{
		title: "Calderería",
		description:
			"Fabricación de estructuras metálicas pesadas, estanques, tolvas y ductos. Soldadura especializada y certificada.",
		alcance: ["Estanques", "Tolvas", "Ductos", "Soldadura certificada"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17 14v6m-3-3h6M6 10h2a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 0h2a2 2 0 002-2V6a2 2 0 00-2-2h-2a2 2 0 00-2 2v2a2 2 0 002 2zM6 20h2a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2z" />`,
	},
	{
		title: "Obras Civiles",
		description:
			"Desarrollo de proyectos de infraestructura para minería, montajes industriales y fundaciones para equipos pesados.",
		alcance: ["Infraestructura minera", "Montajes industriales", "Fundaciones"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`,
	},
	{
		title: "Reparación y Mantención",
		description:
			"Mantenimiento integral y reparación de equipos mineros, palas, perforadoras y maquinaria pesada en terreno o maestranza.",
		alcance: ["Palas", "Perforadoras", "Maquinaria pesada", "Terreno y maestranza"],
		icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />`,
	},
];
---

<section id="servicios" class="section-pad relative bg-steel-50">
	<div class="shell">
		<header class="max-w-2xl reveal">
			<h2
				class="font-display text-3xl font-bold tracking-[-0.03em] text-steel-900 md:text-4xl"
			>
				Capacidades de taller y terreno
			</h2>
			<p class="mt-6 text-lg leading-relaxed text-steel-600">
				Proveemos soluciones robustas y confiables para la industria minera y
				manufacturera, respaldadas por un equipo altamente calificado.
			</p>
		</header>

		<div
			class="mt-14 grid gap-x-16 border-t border-steel-200 md:grid-cols-2"
		>
			{
				servicios.map((servicio, index) => (
					<article
						class="group reveal border-b border-steel-200 py-9"
						data-delay={index}
					>
						<div class="flex gap-5">
							<span
								class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-sm border border-steel-200 bg-white transition-colors duration-300 group-hover:border-flame-300"
							>
								<svg
									class="h-6 w-6 text-flame-700"
									fill="none"
									viewBox="0 0 24 24"
									stroke="currentColor"
									stroke-width="1.5"
									aria-hidden="true"
									set:html={servicio.icon}
								/>
							</span>

							<div class="min-w-0">
								<h3 class="font-display text-xl font-bold text-steel-900 transition-colors duration-200 group-hover:text-flame-800">
									{servicio.title}
								</h3>
								<p class="mt-3 text-[0.95rem] leading-relaxed text-steel-600">
									{servicio.description}
								</p>
								<ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-steel-100 pt-4">
									{servicio.alcance.map((item) => (
										<li class="tech-label text-steel-500">{item}</li>
									))}
								</ul>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
