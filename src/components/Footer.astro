---
const currentYear = new Date().getFullYear();

const enlaces = [
	{ label: "Servicios", href: "/#servicios" },
	{ label: "Quiénes somos", href: "/#nosotros" },
	{ label: "Proyectos", href: "/#proyectos" },
	{ label: "Contacto", href: "/#contacto" },
];
---

<footer class="on-dark border-t border-steel-800 bg-steel-950 pt-16 pb-8">
	<div class="shell">
		<div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
			<!-- Marca -->
			<div class="lg:col-span-4">
				<div class="flex items-center gap-3">
					<img
						src="/images/logo-fexsi.webp"
						alt="Fexsi SpA"
						width="48"
						height="48"
						class="h-12 w-12"
					/>
					<span
						class="font-display text-2xl font-extrabold tracking-[-0.03em] text-white"
					>
						FEXSI<span class="text-flame-500">.</span>
					</span>
				</div>
				<p class="mt-6 max-w-sm leading-relaxed text-steel-400">
					Expertos en maestranza, calderería y obras civiles para el sector
					industrial y la gran minería en la región de Antofagasta.
				</p>

				<div class="mt-8 flex gap-3">
					<a
						href="mailto:operaciones@fexsi.cl"
						class="flex h-11 w-11 items-center justify-center rounded-sm border border-steel-700 text-steel-300 transition-colors hover:border-flame-500 hover:bg-flame-700 hover:text-white"
						aria-label="Enviar correo a operaciones@fexsi.cl"
					>
						<svg
							class="h-5 w-5"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"
							></path>
						</svg>
					</a>
					<a
						href="https://wa.me/56963719477"
						target="_blank"
						rel="noopener noreferrer"
						class="flex h-11 w-11 items-center justify-center rounded-sm border border-steel-700 text-steel-300 transition-colors hover:border-[#25D366] hover:bg-[#25D366] hover:text-white"
						aria-label="Escribir por WhatsApp"
					>
						<svg
							class="h-5 w-5"
							fill="currentColor"
							viewBox="0 0 448 512"
							aria-hidden="true"
						>
							<path
								d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zM223.9 411.4c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 331.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.3-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.2-7.5-3.2z"
							></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- Enlaces -->
			<nav class="lg:col-span-3" aria-label="Enlaces del pie de página">
				<h2 class="tech-label text-steel-400">Enlaces</h2>
				<ul class="mt-6 grid gap-4">
					{
						enlaces.map((enlace) => (
							<li>
								<a
									href={enlace.href}
									class="link-underline text-steel-300 transition-colors hover:text-white"
								>
									{enlace.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<!-- Ubicación -->
			<div class="lg:col-span-5">
				<h2 class="tech-label text-steel-400">Nuestra ubicación</h2>
				<div
					class="mt-6 h-52 overflow-hidden rounded-sm border border-steel-800 bg-steel-900"
				>
					<iframe
						width="100%"
						height="100%"
						title="Mapa de la ubicación de Fexsi SpA en Antofagasta"
						src="https://maps.google.com/maps?q=Uribe%20636,%20Antofagasta,%20Chile&t=&z=16&ie=UTF8&iwloc=&output=embed"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="h-full w-full grayscale"
					></iframe>
				</div>
				<p class="mt-5 flex items-start gap-3 text-sm text-steel-400">
					<svg
						class="mt-0.5 h-5 w-5 shrink-0 text-flame-500"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M17.657 16.657 13.414 20.9a1.998 1.998 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"
						></path>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"
						></path>
					</svg>
					Uribe 636 Of 509 Centro de Negocios, Antofagasta
				</p>
			</div>
		</div>

		<!-- Barra inferior -->
		<div
			class="mt-14 flex flex-col items-center gap-4 border-t border-steel-800 pt-8 md:flex-row md:justify-between"
		>
			<p class="text-sm text-steel-400">
				&copy; {currentYear} Fexsi SpA. Todos los derechos reservados.
			</p>
			<p class="text-sm text-steel-400">
				Desarrollado por
				<a
					href="https://linkedin.com/in/baironvillarberrios"
					target="_blank"
					rel="noopener noreferrer"
					class="link-underline text-flame-400 transition-colors hover:text-flame-300"
					>Bairon Villar</a
				>
			</p>
		</div>
	</div>
</footer>
