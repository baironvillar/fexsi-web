---
---

<header
	id="site-header"
	data-scrolled="false"
	class="fixed inset-x-0 top-0 z-50 border-b border-steel-200 bg-steel-50 transition-shadow duration-300 data-[scrolled=true]:shadow-lift"
>
	<div class="shell">
		<div class="flex h-16 items-center justify-between gap-6 md:h-20">
			<!-- Marca -->
			<a
				href="/"
				class="group flex shrink-0 items-center gap-3"
				aria-label="Fexsi SpA — Inicio"
			>
				<img
					src="/images/logo-fexsi.webp"
					alt="Fexsi SpA"
					width="40"
					height="40"
					class="h-10 w-10 transition-transform duration-500 group-hover:scale-105"
				/>
				<span
					class="font-display text-xl font-extrabold tracking-[-0.03em] text-steel-900 md:text-2xl"
				>
					FEXSI<span class="text-flame-700">.</span>
				</span>
			</a>

			<!-- Navegación escritorio -->
			<nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
				<a
					href="/#servicios"
					class="link-underline text-sm font-semibold text-steel-600 transition-colors hover:text-steel-900 data-[active=true]:text-steel-900"
				>
					Servicios
				</a>
				<a
					href="/#nosotros"
					class="link-underline text-sm font-semibold text-steel-600 transition-colors hover:text-steel-900 data-[active=true]:text-steel-900"
				>
					Nosotros
				</a>
				<a
					href="/#proyectos"
					class="link-underline text-sm font-semibold text-steel-600 transition-colors hover:text-steel-900 data-[active=true]:text-steel-900"
				>
					Proyectos
				</a>
				<a
					href="/#contacto"
					class="inline-flex h-11 items-center justify-center rounded-sm bg-flame-700 px-5 text-sm font-semibold text-white transition-colors duration-200 hover:bg-flame-800"
				>
					Cotizar proyecto
				</a>
			</nav>

			<!-- Menú móvil -->
			<button
				type="button"
				id="mobile-menu-btn"
				class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-sm text-steel-700 transition-colors hover:text-flame-700 md:hidden noscript:hidden"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg
					class="h-6 w-6"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Panel móvil: `noscript:block` mantiene la navegación accesible si el JS falla -->
	<div
		id="mobile-menu"
		class="hidden border-t border-steel-200 bg-steel-50 md:hidden max-md:noscript:block"
	>
		<nav class="shell flex flex-col py-3" aria-label="Menú móvil">
			<a
				href="/#servicios"
				class="mobile-link border-b border-steel-200 py-4 text-base font-semibold text-steel-700 transition-colors hover:text-flame-700"
			>
				Servicios
			</a>
			<a
				href="/#nosotros"
				class="mobile-link border-b border-steel-200 py-4 text-base font-semibold text-steel-700 transition-colors hover:text-flame-700"
			>
				Nosotros
			</a>
			<a
				href="/#proyectos"
				class="mobile-link border-b border-steel-200 py-4 text-base font-semibold text-steel-700 transition-colors hover:text-flame-700"
			>
				Proyectos
			</a>
			<a
				href="/#contacto"
				class="mobile-link mt-4 inline-flex h-12 items-center justify-center rounded-sm bg-flame-700 px-5 text-base font-semibold text-white transition-colors hover:bg-flame-800"
			>
				Cotizar proyecto
			</a>
		</nav>
	</div>
</header>

<script>
	function initHeader() {
		const header = document.getElementById("site-header");
		const button = document.getElementById("mobile-menu-btn");
		const menu = document.getElementById("mobile-menu");

		// Estado "scrolled" para la sombra del header
		if (header && !header.dataset.scrollBound) {
			header.dataset.scrollBound = "true";
			const update = () => {
				header.dataset.scrolled = String(window.scrollY > 8);
			};
			update();
			window.addEventListener("scroll", update, { passive: true });
		}

		// Menú móvil
		if (button && menu && !button.dataset.bound) {
			button.dataset.bound = "true";

			const setOpen = (open: boolean) => {
				menu.classList.toggle("hidden", !open);
				button.setAttribute("aria-expanded", String(open));
				button.setAttribute(
					"aria-label",
					open ? "Cerrar menú" : "Abrir menú",
				);
			};

			button.addEventListener("click", () => {
				setOpen(button.getAttribute("aria-expanded") !== "true");
			});

			menu.querySelectorAll(".mobile-link").forEach((link) => {
				link.addEventListener("click", () => setOpen(false));
			});

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
					setOpen(false);
					button.focus();
				}
			});
		}
	}

	initHeader();
	document.addEventListener("astro:page-load", initHeader);
</script>
