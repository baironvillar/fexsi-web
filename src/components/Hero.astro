---
const capacidades = [
	"Maestranza",
	"Calderería",
	"Obras civiles",
	"Reparación y mantención",
];
---

<section
	id="inicio"
	class="on-dark relative flex min-h-[100svh] flex-col justify-end overflow-hidden bg-steel-950"
>
	<!-- Fondo -->
	<div class="absolute inset-0 z-0">
		<img
			src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?q=80&w=2070&auto=format&fit=crop"
			alt=""
			fetchpriority="high"
			decoding="async"
			class="h-full w-full object-cover object-center"
		/>
		<div
			class="absolute inset-0 bg-[linear-gradient(104deg,rgba(11,17,22,0.97)_0%,rgba(11,17,22,0.92)_36%,rgba(11,17,22,0.62)_68%,rgba(11,17,22,0.78)_100%)]"
		>
		</div>
		<div class="absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(to_top,rgba(11,17,22,0.9),transparent)]">
		</div>
	</div>

	<div class="shell hero-pad relative z-10 flex flex-1 flex-col justify-center">
		<div class="max-w-3xl">
			<h1
				class="reveal font-display text-[2.75rem] font-extrabold leading-[1.04] tracking-[-0.035em] text-white sm:text-6xl lg:text-7xl"
			>
				Soluciones Metalúrgicas de
				<span class="text-flame-400">Excelencia</span>
			</h1>

			<p
				class="reveal delay-1 mt-7 max-w-xl text-lg leading-relaxed text-steel-300 sm:text-xl"
			>
				Especialistas en maestranza, calderería y obras civiles para el sector
				industrial y minero.
			</p>

			<div class="reveal delay-2 mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
				<a
					href="/#contacto"
					class="inline-flex h-13 items-center justify-center rounded-sm bg-flame-700 px-8 text-base font-semibold text-white transition-colors duration-200 hover:bg-flame-800"
				>
					Solicitar presupuesto
				</a>
				<a
					href="/#servicios"
					class="inline-flex h-13 items-center justify-center rounded-sm border border-steel-500 px-8 text-base font-semibold text-steel-100 transition-colors duration-200 hover:border-flame-500 hover:text-white"
				>
					Conocer servicios
				</a>
			</div>
		</div>
	</div>

	<!-- Banda de capacidades -->
	<div class="shell hero-band relative z-10 border-t border-white/10">
		<div class="flex flex-col gap-6 pt-6 md:flex-row md:items-center md:justify-between">
			<ul
				class="flex flex-wrap items-center gap-x-7 gap-y-2 text-steel-200"
				aria-label="Áreas de servicio"
			>
				{
					capacidades.map((item) => (
						<li class="tech-label text-steel-300">{item}</li>
					))
				}
			</ul>

			<a
				href="#servicios"
				class="group hidden items-center gap-3 text-steel-400 transition-colors hover:text-white lg:flex"
				aria-label="Ir a servicios"
			>
				<span class="tech-label">Desplácese</span>
				<span class="scroll-hint-line relative block h-10 w-px overflow-hidden bg-white/15">
					<span
						class="absolute inset-x-0 top-0 block h-1/2 origin-top bg-flame-400"
					>
					</span>
				</span>
			</a>
		</div>
	</div>
</section>

<style>
	@keyframes scroll-hint {
		0% {
			transform: translateY(-100%);
		}
		55%,
		100% {
			transform: translateY(200%);
		}
	}

	.scroll-hint-line > span {
		animation: scroll-hint 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
	}
</style>
