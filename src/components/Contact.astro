---
const datosContacto = [
	{
		label: "Dirección",
		value: "Uribe 636 Of 509 C. De Negocios",
		detalle: "Antofagasta, Chile",
		icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657 13.414 20.9a1.998 1.998 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />`,
	},
	{
		label: "Email",
		value: "operaciones@fexsi.cl",
		detalle: "Consultas y cotizaciones",
		href: "mailto:operaciones@fexsi.cl",
		icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" />`,
	},
	{
		label: "Teléfono",
		value: "+56 9 6371 9477",
		detalle: "Atención directa",
		href: "tel:+56963719477",
		icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 0 1 2-2h3.28a1 1 0 0 1 .948.684l1.498 4.493a1 1 0 0 1-.502 1.21l-2.257 1.13a11.042 11.042 0 0 0 5.516 5.516l1.13-2.257a1 1 0 0 1 1.21-.502l4.493 1.498a1 1 0 0 1 .684.949V19a2 2 0 0 1-2 2h-1C9.716 21 3 14.284 3 6V5z" />`,
	},
];
---

<section id="contacto" class="on-dark section-pad relative overflow-hidden bg-steel-900">
	<div class="shell relative">
		<div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
			<!-- Datos de contacto -->
			<div class="lg:col-span-5">
				<h2
					class="reveal-left font-display text-3xl font-bold tracking-[-0.03em] text-white md:text-4xl"
				>
					Soluciones para la gran industria
				</h2>
				<p class="reveal-left delay-1 mt-6 text-lg leading-relaxed text-steel-300">
					¿Tiene un proyecto en mente o requiere servicios metalúrgicos
					especializados? Nuestro equipo de expertos está listo para asesorarle.
				</p>

				<dl class="mt-12 border-t border-steel-700">
					{
						datosContacto.map((dato) => (
							<div class="flex items-start gap-5 border-b border-steel-700 py-6">
								<span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-sm border border-steel-700 text-flame-500">
									<svg
										class="h-5 w-5"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
										set:html={dato.icon}
									/>
								</span>
								<div class="min-w-0">
									<dt class="tech-label text-steel-400">{dato.label}</dt>
									<dd class="mt-1.5">
										{dato.href ? (
											<a
												href={dato.href}
												class="link-underline block text-lg font-semibold text-white transition-colors hover:text-flame-400"
											>
												{dato.value}
											</a>
										) : (
											<span class="block text-lg font-semibold text-white">
												{dato.value}
											</span>
										)}
										<span class="mt-1 block text-sm text-steel-400">
											{dato.detalle}
										</span>
									</dd>
								</div>
							</div>
						))
					}
				</dl>
			</div>

			<!-- Formulario -->
			<div class="reveal-right lg:col-span-7">
				<div
					class="rounded-sm border border-steel-700 bg-steel-50 p-6 shadow-panel sm:p-8"
				>
					<h3 class="font-display text-2xl font-bold tracking-[-0.02em] text-steel-900">
						Envíenos un mensaje
					</h3>
					<p class="mt-2 text-sm text-steel-500">
						Respondemos a la brevedad. Cuente con el detalle de su necesidad para
						preparar una cotización.
					</p>

					<form id="contact-form" class="mt-8 grid gap-5" novalidate>
						<input
							type="hidden"
							name="access_key"
							value="30b97354-2f06-4bab-baa2-5c7e688fba15"
						/>
						<input type="hidden" id="subject" name="subject" value="Mensaje desde Fexsi.cl" />
						<input type="checkbox" name="botcheck" class="hidden" />

						<div class="grid gap-5 sm:grid-cols-2">
							<div>
								<label for="name" class="block text-sm font-semibold text-steel-700">
									Nombre completo
								</label>
								<input
									type="text"
									id="name"
									name="Nombre"
									autocomplete="name"
									required
									placeholder="Juan Pérez"
									class="mt-2 h-12 w-full rounded-sm border border-steel-400 bg-white px-4 text-[0.95rem] text-steel-900 placeholder:text-steel-500 transition-colors focus:border-flame-600 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-600"
								/>
							</div>
							<div>
								<label for="company" class="block text-sm font-semibold text-steel-700">
									Empresa
								</label>
								<input
									type="text"
									id="company"
									name="Empresa"
									autocomplete="organization"
									placeholder="Su empresa"
									class="mt-2 h-12 w-full rounded-sm border border-steel-400 bg-white px-4 text-[0.95rem] text-steel-900 placeholder:text-steel-500 transition-colors focus:border-flame-600 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-600"
								/>
							</div>
						</div>

						<div>
							<label for="email" class="block text-sm font-semibold text-steel-700">
								Correo electrónico
							</label>
							<input
								type="email"
								id="email"
								name="Email"
								autocomplete="email"
								required
								placeholder="correo@empresa.cl"
								class="mt-2 h-12 w-full rounded-sm border border-steel-400 bg-white px-4 text-[0.95rem] text-steel-900 placeholder:text-steel-500 transition-colors focus:border-flame-600 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-600"
							/>
						</div>

						<div>
							<label for="message" class="block text-sm font-semibold text-steel-700">
								Mensaje o requerimiento
							</label>
							<textarea
								id="message"
								name="Mensaje"
								required
								rows="5"
								placeholder="Describa su proyecto o necesidad…"
								class="mt-2 w-full resize-y rounded-sm border border-steel-400 bg-white px-4 py-3 text-[0.95rem] leading-relaxed text-steel-900 placeholder:text-steel-500 transition-colors focus:border-flame-600 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-flame-600"
							></textarea>
						</div>

						<button
							type="submit"
							id="submit-button"
							class="inline-flex h-13 items-center justify-center gap-2 rounded-sm bg-flame-700 px-6 text-base font-semibold text-white transition-colors duration-200 hover:bg-flame-800 disabled:cursor-not-allowed disabled:opacity-70"
						>
							<span id="button-text">Enviar mensaje</span>
							<svg
								id="loading-spinner"
								class="hidden h-5 w-5 animate-spin"
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<circle
									class="opacity-25"
									cx="12"
									cy="12"
									r="10"
									stroke="currentColor"
									stroke-width="4"></circle>
								<path
									class="opacity-75"
									fill="currentColor"
									d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 0 1 4 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
								></path>
							</svg>
						</button>

						<p
							id="form-status"
							role="status"
							aria-live="polite"
							class="hidden rounded-sm p-3 text-center text-sm font-medium"
						>
						</p>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	function initContactForm() {
		const form = document.getElementById("contact-form") as HTMLFormElement | null;
		if (!form || form.dataset.bound === "true") return;
		form.dataset.bound = "true";

		form.addEventListener("submit", async (e) => {
			e.preventDefault();

			// Los elementos se resuelven en el momento del envío: nada queda
			// referenciado a nodos que el router de vistas pudo reemplaz.
			const submitButton = form.querySelector<HTMLButtonElement>("#submit-button");
			const buttonText = form.querySelector<HTMLElement>("#button-text");
			const spinner = form.querySelector<HTMLElement>("#loading-spinner");
			const statusEl = form.querySelector<HTMLElement>("#form-status");

			if (!submitButton || !buttonText || !spinner || !statusEl) return;

			const setStatus = (message: string, tone: "ok" | "error") => {
				statusEl.textContent = message;
				statusEl.classList.remove(
					"hidden",
					"bg-success-50",
					"text-success-800",
					"bg-danger-50",
					"text-danger-800",
				);
				statusEl.classList.add(
					tone === "ok" ? "bg-success-50" : "bg-danger-50",
					tone === "ok" ? "text-success-800" : "text-danger-800",
				);
			};

			submitButton.disabled = true;
			buttonText.textContent = "Enviando…";
			spinner.classList.remove("hidden");
			statusEl.classList.add("hidden");

			const formData = new FormData(form);
			const emailValue = formData.get("Email") || "Contacto";
			formData.set("subject", `Mensaje desde Fexsi.cl - ${emailValue}`);

			try {
				const response = await fetch("https://api.web3forms.com/submit", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						Accept: "application/json",
					},
					body: JSON.stringify(Object.fromEntries(formData)),
				});

				if (response.status === 200) {
					setStatus(
						"¡Mensaje enviado con éxito! Nos pondremos en contacto pronto.",
						"ok",
					);
					form.reset();
				} else {
					setStatus(
						"Hubo un error al enviar el mensaje. Por favor intente más tarde.",
						"error",
					);
				}
			} catch (error) {
				console.error(error);
				setStatus(
					"Error de conexión. Verifique su internet e intente nuevamente.",
					"error",
				);
			} finally {
				submitButton.disabled = false;
				buttonText.textContent = "Enviar mensaje";
				spinner.classList.add("hidden");

				if (statusEl.classList.contains("bg-success-50")) {
					setTimeout(() => statusEl.classList.add("hidden"), 5000);
				}
			}
		});
	}

	initContactForm();
	document.addEventListener("astro:page-load", initContactForm);
</script>
